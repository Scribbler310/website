{
  "name": "website",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,green \"npm run dev -w client\" \"npm run dev -w server\"",
    "build": "npm run build -w client",
    "lint": "npm run lint -w client",
    "test": "npm test -w server",
    "start": "npm start -w server"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
